# Copy this file to .env and fill in real values.
# Never commit the .env file itself — it is already excluded via .gitignore.

# Discord webhook URL to post alerts to (required).
# Create one in Discord: Server Settings > Integrations > Webhooks > New Webhook.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Stock ticker to monitor (optional, defaults to AAPL).
STOCK_TICKER=AAPL

# Absolute percentage change required to trigger an alert (optional, defaults to 2.0).
ALERT_THRESHOLD=2.0
